APP_NAME="Portofolio Fajar"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.portofoliofajar.my.id

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# -------------------------------------------------------------
# PENGATURAN DATABASE (cPanel / DirectAdmin MySQL)
# Buat database, user, dan grant all privileges di menu MySQL Database
# -------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nama_cpanel_db
DB_USERNAME=nama_cpanel_user
DB_PASSWORD=password_user_db

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# -------------------------------------------------------------
# CLOUDINARY CLOUD STORAGE (Media Gambar)
# Salin dari Dashboard Cloudinary Anda
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
# -------------------------------------------------------------
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_NOTIFICATION_URL=

# Domain Frontend yang diizinkan CORS
SANCTUM_STATEFUL_DOMAINS=portofoliofajar.my.id,www.portofoliofajar.my.id
SESSION_DOMAIN=.portofoliofajar.my.id

